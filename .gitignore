# push.bat が pull 前に作成する data.json の退避バックアップ（コミット不要）
data.json.autobak

# スキルのPythonキャッシュ（auto-push が拾わないように）
__pycache__/
*.pyc

# artrays-data MCP サーバーが書き込み直前に退避する data.json のバックアップ
_backups/

# artrays-genka MCP サーバーの接続先（Apps Script のURLとトークン）
mcp/.genka_config.json

# 各セッションが data.json 編集前に作る退避バックアップ／破損時の退避コピー（コミット不要）
# data.json 単体で約500KBあるため、コミットすると GitHub Pages 配信まで肥大する。
# ★ 今後の退避先はリポジトリ外（C:\Users\user\artrays_backups\）を使うこと
data.json.bak
data.json.bak_*
data.json.broken_*
data.json.BROKEN_*
data.json.tmp_*

# 各HTMLアプリの編集前バックアップ（dashboard.html.bak_* / mitsumori_seikyu_preview.html.bak_* 等）
*.html.bak_*

# auto_push.bat が退避した stale な index.lock の置き場
_tmp_lockarchive/

# hookify のローカルルール（GitHub Pages で公開する必要が無いローカル設定）
.claude/*.local.md

# data.json の破損コピー・日付付きバックアップ（リポジトリ外 artrays_backups/ へ退避する運用）
# ※ 公開サイトなので、ここに置いたままだと GitHub Pages から誰でもDLできてしまう
data.json.CORRUPT*
data.json.backup_*
data.json.write_test
data.backup_*
data.bak_*

# PostToolUse フックが data.json の変化検知に使う指紋ファイル
.claude/.data_json_state
