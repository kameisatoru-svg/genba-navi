{
  "mcpServers": {
    "artrays-data": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${CLAUDE_PROJECT_DIR}/mcp/artrays_data_server.py"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "artrays-genka": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${CLAUDE_PROJECT_DIR}/mcp/artrays_genka_server.py"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
